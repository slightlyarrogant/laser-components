generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              Int                             @id @default(autoincrement())
  email                           String                          @unique
  passwordHash                    String                          @map("password_hash")
  role                            UserRole                        @default(SALES)
  createdAt                       DateTime                        @default(now()) @map("created_at")
  updatedAt                       DateTime                        @updatedAt @map("updated_at")
  resetTokenExpiry                DateTime?                       @map("reset_token_expiry")
  resetTokenHash                  String?                         @map("reset_token_hash")
  isActive                        Boolean                         @default(true) @map("is_active")
  displayName                     String?                         @map("display_name")
  activities                      ActivityLog[]
  industrial_application_research IndustrialApplicationResearch[]
  leads                           Lead[]                          @relation("LeadCreatedBy")
  oauthAuthCodes                  OAuthAuthCode[]
  oauthRefreshTokens              OAuthRefreshToken[]
  ownedLeads                      Lead[]                          @relation("LeadOwner")
  regions                         UserRegion[]
  research_attachments            ResearchAttachment[]
  ResearchCollaborator            ResearchCollaborator[]
  research_versions               ResearchVersion[]
  searchTemplates                 SearchTemplate[]

  @@map("users")
}

/// Region competency for a user. NO rows for a user = GLOBAL competency
/// (may write unowned leads anywhere); one or more rows = the user may only
/// claim unowned leads whose region (directly, or via the lead's country)
/// is in this set. Ownership and authorship always override competency.
model UserRegion {
  userId   Int    @map("user_id")
  regionId Int    @map("region_id")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, regionId])
  @@map("user_regions")
}

/// OAuth 2.0 dynamic client registry (RFC 7591). `redirectUris` is the exact
/// allow-list /authorize matches against; an empty array means the client is
/// known but cannot start a flow until it re-registers.
/// Mirrors db/migrations/2026-09-15-oauth-state.sql.
model OAuthClient {
  clientId     String    @id @map("client_id")
  clientName   String?   @map("client_name")
  redirectUris String[]  @map("redirect_uris")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)

  @@map("oauth_clients")
}

/// Single-use authorization codes. Redemption is a DELETE ... RETURNING, so a
/// code can be exchanged exactly once even under concurrent requests.
model OAuthAuthCode {
  code                String   @id
  clientId            String   @map("client_id")
  userId              Int      @map("user_id")
  redirectUri         String   @map("redirect_uri")
  codeChallenge       String?  @map("code_challenge")
  codeChallengeMethod String?  @map("code_challenge_method")
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@map("oauth_auth_codes")
}

/// Rotating refresh tokens. The primary key is sha256(token) in hex — the raw
/// token is never stored. Rotation sets `usedAt` instead of deleting, so a
/// replayed token stays distinguishable from an unknown one until it expires.
model OAuthRefreshToken {
  tokenHash String    @id @map("token_hash")
  clientId  String    @map("client_id")
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("oauth_refresh_tokens")
}

model SearchTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  filters     Json
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("search_templates")
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id                              Int                             @id @default(autoincrement())
  name                            String
  description                     String?
  categoryId                      Int                             @map("category_id")
  createdAt                       DateTime                        @default(now()) @map("created_at")
  updatedAt                       DateTime                        @updatedAt @map("updated_at")
  industrial_application_research IndustrialApplicationResearch[]
  products                        Product[]
  category                        Category                        @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, name])
  @@map("subcategories")
}

model Product {
  id                      Int                             @id @default(autoincrement())
  name                    String
  description             String?
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")
  datasheet_url           String?
  price                   Decimal?                        @db.Decimal(10, 2)
  sku                     String?                         @unique
  specifications          Json?
  subcategoryId           Int                             @map("subcategory_id")
  discoveredResearchItems IndustrialApplicationResearch[] @relation("DiscoveredFromProduct")
  ResearchItems           IndustrialApplicationResearch[]
  leads                   Lead[]
  product_applications    ApplicationProduct[]
  subcategory             Subcategory                     @relation(fields: [subcategoryId], references: [id])

  @@unique([name, subcategoryId])
  @@map("products")
}

model Application {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique
  description          String?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  status               ApplicationStatus    @default(ACTIVE)
  leads                Lead[]
  product_applications ApplicationProduct[]

  @@map("applications")
}

model Region {
  id             Int          @id @default(autoincrement())
  name           String       @unique
  code           String?      @unique
  parentRegionId Int?         @map("parent_region_id")
  countries      Country[]
  leads          Lead[]
  parentRegion   Region?      @relation("regionsToregions", fields: [parentRegionId], references: [id])
  subRegions     Region[]     @relation("regionsToregions")
  users          UserRegion[]

  @@map("regions")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  regionId  Int      @map("region_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  region    Region   @relation(fields: [regionId], references: [id])
  leads     Lead[]

  @@map("countries")
}

model Lead {
  id               Int                            @id @default(autoincrement())
  name             String
  email            String?
  phone            String?
  status           LeadStatus                     @default(NEW)
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")
  annualRevenue    Decimal?                       @map("annual_revenue") @db.Decimal(15, 2)
  confidence       Decimal?                       @db.Decimal(5, 2)
  countryId        Int?                           @map("country_id")
  description      String?
  employeeCount    Int?                           @map("employee_count")
  foundedYear      Int?                           @map("founded_year")
  industry         String?
  lastEnriched     DateTime?                      @map("last_enriched")
  linkedInUrl      String?                        @map("linkedin_url")
  location         String?
  regionId         Int?                           @map("region_id")
  source           String?
  sourceId         String?                        @map("source_id")
  tags             String[]
  website          String?
  sourceResearchId Int?
  applicationId    Int?
  organizationId   Int?
  productId        Int
  createdByUserId  Int?                           @map("created_by_user_id")
  ownerUserId      Int?                           @map("owner_user_id")
  enrichmentJobs   EnrichmentJob[]
  application      Application?                   @relation(fields: [applicationId], references: [id])
  country          Country?                       @relation(fields: [countryId], references: [id])
  createdByUser    User?                          @relation("LeadCreatedBy", fields: [createdByUserId], references: [id])
  ownerUser        User?                          @relation("LeadOwner", fields: [ownerUserId], references: [id])
  organization     Organization?                  @relation(fields: [organizationId], references: [id])
  product          Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  region           Region?                        @relation(fields: [regionId], references: [id])
  sourceResearch   IndustrialApplicationResearch? @relation(fields: [sourceResearchId], references: [id])
  notes            Note[]
  scoreOverride    ScoreOverride?

  @@index([ownerUserId])
  @@index([createdByUserId])
  @@index([regionId])
  @@index([countryId])
  @@index([status])
  @@index([productId])
  @@index([createdAt(sort: Desc)])
  @@map("leads")
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  website   String?
  industry  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  leads     Lead[]

  @@map("organizations")
}

model EnrichmentBatch {
  id            Int             @id @default(autoincrement())
  name          String
  description   String?
  totalJobs     Int
  completedJobs Int             @default(0) @map("completed_jobs")
  failedJobs    Int             @default(0) @map("failed_jobs")
  status        String          @default("PENDING")
  createdBy     String?         @map("created_by")
  startedAt     DateTime?       @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  metadata      String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @map("updated_at")
  jobs          EnrichmentJob[]

  @@map("enrichment_batches")
}

model EnrichmentJob {
  id            Int                 @id @default(autoincrement())
  batchId       Int?                @map("batch_id")
  leadId        Int                 @map("lead_id")
  status        EnrichmentJobStatus @default(PENDING)
  attempts      Int                 @default(0)
  result        String?
  lastAttemptAt DateTime?           @map("last_attempt_at")
  completedAt   DateTime?           @map("completed_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @map("updated_at")
  metadata      String?
  provider      String
  batch         EnrichmentBatch?    @relation(fields: [batchId], references: [id])
  lead          Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([status, lastAttemptAt])
  @@map("enrichment_jobs")
}

model Note {
  id        Int      @id @default(autoincrement())
  leadId    Int      @map("lead_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user_id   Int?
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([user_id])
  @@map("notes")
}

model TagPreset {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color       String   @default("#3f51b5")
  description String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("tag_presets")
}

model ActivityLog {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  action        String
  resource_type String
  resource_id   String?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  details       Json?
  timestamp     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource_type])
  @@index([timestamp])
  @@map("activity_logs")
}

model IndustrialApplicationResearch {
  id                      Int                    @id @default(autoincrement())
  applicationName         String                 @map("application_name")
  industrySector          String?                @map("industry_sector")
  useCaseDescription      String?                @map("use_case_description")
  marketPotential         String?                @map("market_potential")
  technicalRequirements   String?                @map("technical_requirements")
  competitiveLandscape    String?                @map("competitive_landscape")
  status                  ResearchStatus         @default(DRAFT)
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  createdByUserId         Int                    @map("created_by_user_id")
  subcategoryId           Int?                   @map("subcategory_id")
  productId               Int?                   @map("product_id")
  aiSummary               String?                @map("ai_summary")
  aiRecommendations       String?                @map("ai_recommendations")
  aiConfidenceScore       Float?                 @map("ai_confidence_score")
  discoveredFromProductId Int?                   @map("discovered_from_product_id")
  createdByUser           User                   @relation(fields: [createdByUserId], references: [id])
  discoveredFromProduct   Product?               @relation("DiscoveredFromProduct", fields: [discoveredFromProductId], references: [id])
  product                 Product?               @relation(fields: [productId], references: [id])
  subcategory             Subcategory?           @relation(fields: [subcategoryId], references: [id])
  leads                   Lead[]
  attachments             ResearchAttachment[]
  collaborators           ResearchCollaborator[]
  versions                ResearchVersion[]

  @@map("industrial_application_research")
}

model ResearchAttachment {
  id               Int                           @id @default(autoincrement())
  researchId       Int                           @map("research_id")
  url              String
  attachmentType   String                        @map("attachment_type")
  description      String?
  uploadedAt       DateTime                      @default(now()) @map("uploaded_at")
  uploadedByUserId Int                           @map("uploaded_by_user_id")
  research         IndustrialApplicationResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  uploadedByUser   User                          @relation(fields: [uploadedByUserId], references: [id])

  @@map("research_attachments")
}

model ResearchCollaborator {
  researchId  Int                           @map("research_id")
  userId      Int                           @map("user_id")
  assigned_at DateTime                      @default(now())
  role        String
  research    IndustrialApplicationResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)
  user        User                          @relation(fields: [userId], references: [id])

  @@id([researchId, userId])
  @@map("research_collaborators")
}

model ResearchVersion {
  id                Int                           @id @default(autoincrement())
  researchId        Int                           @map("research_id")
  versionNumber     Int                           @map("version_number")
  dataSnapshot      Json                          @map("data_snapshot")
  changeDescription String?                       @map("change_description")
  createdAt         DateTime                      @default(now()) @map("created_at")
  createdByUserId   Int                           @map("created_by_user_id")
  createdByUser     User                          @relation(fields: [createdByUserId], references: [id])
  research          IndustrialApplicationResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@unique([researchId, versionNumber])
  @@index([researchId, createdAt])
  @@map("research_versions")
}

model analytics_events {
  id         Int      @id @default(autoincrement())
  event_type String
  category   String
  action     String
  entity_id  String
  metadata   Json?
  timestamp  DateTime @default(now())
  user_id    Int?

  @@index([action])
  @@index([category])
  @@index([event_type])
  @@index([timestamp])
}

model metric_aggregates {
  id          Int      @id @default(autoincrement())
  metric_name String
  dimensions  Json?
  count       Int
  sum         Float?
  min         Float?
  max         Float?
  avg         Float?
  start_date  DateTime
  end_date    DateTime
  created_at  DateTime @default(now())

  @@unique([metric_name, dimensions, start_date, end_date])
  @@index([metric_name])
  @@index([start_date, end_date])
}

model metric_values {
  id          Int      @id @default(autoincrement())
  metric_name String
  value       Float
  dimensions  Json?
  timestamp   DateTime @default(now())

  @@index([metric_name])
  @@index([timestamp])
}

model ApplicationProduct {
  productId     Int         @map("product_id")
  applicationId Int         @map("application_id")
  assignedAt    DateTime    @default(now()) @map("assigned_at")
  assignedBy    String
  application   Application @relation(fields: [applicationId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@id([productId, applicationId])
  @@map("product_applications")
}

model ScoreOverride {
  id                 Int      @id @default(autoincrement())
  leadId             Int      @unique @map("lead_id")
  score              Int?
  componentOverrides String?  @map("component_overrides")
  metadata           String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @map("updated_at")
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("score_overrides")
}

enum UserRole {
  ADMIN
  RESEARCHER
  SALES
}

enum ApplicationStatus {
  ACTIVE
  INACTIVE
}

enum ResearchStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  PENDING_APPROVAL
  AI_DISCOVERED
  REVIEWED
  REJECTED
}

enum EnrichmentJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RATE_LIMITED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  WON
}

model Resource {
  id        Int               @id @default(autoincrement())
  slug      String            @unique
  title     String
  content   String
  category  String
  version   Int               @default(1)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  versions  ResourceVersion[]
  events    LearningEvent[]

  @@map("resources")
}

model ResourceVersion {
  id           Int      @id @default(autoincrement())
  resourceId   Int      @map("resource_id")
  content      String
  version      Int
  changeReason String?  @map("change_reason")
  changedBy    String?  @map("changed_by")
  createdAt    DateTime @default(now()) @map("created_at")
  resource     Resource @relation(fields: [resourceId], references: [id])

  @@map("resource_versions")
}

model LearningEvent {
  id              Int       @id @default(autoincrement())
  eventType       String    @map("event_type")
  resourceSlug    String?   @map("resource_slug")
  observation     String
  context         String?
  suggestedUpdate String?   @map("suggested_update")
  impact          String    @default("medium")
  applied         Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at")
  resource        Resource? @relation(fields: [resourceSlug], references: [slug])

  @@map("learning_events")
}
